# ==========================================================
# Cara Stores Environment Template
# Copy to .env and replace placeholder values.
# ==========================================================

# ─── PostgreSQL (local setup via peer auth over Unix socket) ───────
# Local development:
#   - setup script runs as postgres OS user via Unix socket (peer auth, no postgres password)
#   - app runtime connects as app role over TCP with password
POSTGRES_SOCKET_DIR="/run/postgresql"
POSTGRES_PORT="5432"
POSTGRES_DB="cara"
POSTGRES_USER="cara_app"
POSTGRES_PASSWORD="change-this-password"
DATABASE_URL="postgresql://cara_app:change-this-password@127.0.0.1:5432/cara?schema=public"
DIRECT_URL="postgresql://cara_app:change-this-password@127.0.0.1:5432/cara?schema=public"

# Remote PostgreSQL (Neon / Supabase / self-hosted):
#   Uncomment below for TCP+password auth to a remote server.
# DATABASE_URL="postgresql://cara_app:your-password@your-host:5432/cara?schema=public"
# DIRECT_URL="postgresql://cara_app:your-password@your-host:5432/cara?schema=public"

# ─── NextAuth ─────────────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="change-me-to-a-random-secret"
NEXTAUTH_URL="http://localhost:3000"

# ─── OpenAI (optional, enables AI assistant/search) ──────
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4.1-mini"
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"

# ─── Catalog ingestion tuning ─────────────────────────────
# USD to KES conversion fallback used during scraping.
CATALOG_USD_TO_KES="129"

# ─── Scheduled refresh security ───────────────────────────
# Used by /api/cron/catalog-refresh Authorization bearer check.
CRON_SECRET="change-me-to-a-random-secret"

# ─── M-Pesa Daraja API ───────────────────────────────────
MPESA_CONSUMER_KEY=""
MPESA_CONSUMER_SECRET=""
MPESA_PASSKEY=""
MPESA_SHORTCODE="174379"
MPESA_ENV="sandbox"
# Your public callback endpoint (ngrok/domain in dev).
MPESA_CALLBACK_URL="https://your-domain.com/api/checkout/callback"
