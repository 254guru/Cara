generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Auth ───────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  phone         String?   @unique
  passwordHash  String
  role          Role      @default(BUYER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  cartItems     CartItem[]
  orders        Order[]
  chatSessions  ChatSession[]

  @@map("users")
}

enum Role {
  BUYER
  SELLER
  ADMIN
}

// ─── Catalog ────────────────────────────────────────────

model Product {
  id          Int       @id @default(autoincrement())
  source      String    @default("manual")
  externalId  String?
  brand       String
  title       String
  description String    @default("")
  price       Float
  image       String
  rating      Float     @default(0)
  fullRating  Boolean   @default(false)
  category    String    @default("general")
  inStock     Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  cartItems   CartItem[]
  orderItems  OrderItem[]
  embedding   ProductEmbedding?

  @@unique([source, externalId])

  @@map("products")
}

// ─── Catalog source health ──────────────────────────────

model CatalogSource {
  id               String    @id @default(cuid())
  name             String    @unique
  displayName      String
  url              String
  healthScore      Float     @default(1.0)
  consecutiveFails Int       @default(0)
  totalRuns        Int       @default(0)
  totalOkRuns      Int       @default(0)
  lastRunAt        DateTime?
  lastRunOk        Boolean   @default(true)
  lastItemCount    Int       @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@map("catalog_sources")
}

model ProductEmbedding {
  id         String   @id @default(cuid())
  productId  Int      @unique @map("product_id")
  sourceText String   @map("source_text")
  embedding  Unsupported("vector(1536)")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_embeddings")
}

// ─── Cart (server-persisted) ────────────────────────────

model CartItem {
  id        String   @id @default(cuid())
  userId    String
  productId Int
  quantity  Int      @default(1)
  size      String   @default("M")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId, size])
  @@map("cart_items")
}

// ─── Orders ─────────────────────────────────────────────

model Order {
  id              String      @id @default(cuid())
  userId          String
  status          OrderStatus @default(PENDING)
  total           Float
  shippingOption  String
  paymentMethod   String
  mpesaReceiptNo  String?
  phone           String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  items           OrderItem[]

  @@map("orders")
}

enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  DELIVERED
  CANCELLED
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId Int
  quantity  Int
  size      String
  price     Float

  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("order_items")
}

model ChatSession {
  id        String       @id @default(cuid())
  userId    String       @map("user_id")
  title     String       @default("Shopping Assistant")
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  ChatMessage[]

  @@index([userId, updatedAt])
  @@map("chat_sessions")
}

model ChatMessage {
  id        String    @id @default(cuid())
  sessionId String    @map("session_id")
  role      ChatRole
  content   String
  createdAt DateTime  @default(now()) @map("created_at")

  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
  @@map("chat_messages")
}

enum ChatRole {
  USER
  ASSISTANT
}
